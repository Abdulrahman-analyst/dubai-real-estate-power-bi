	partition FactSales = m
		mode: import
		source =
				let
				    Source = Table.Combine({DLD_Transactions_2023_RAW, DLD_Transactions_2024_RAW, DLD_Transactions_2025_RAW}),
				    #"Filtered Rows" = Table.SelectRows(Source, each ([trans_group_en] = "Sales")),
				    #"Changed Type with Locale" = Table.TransformColumnTypes(#"Filtered Rows", {{"instance_date", type date}}, "en-GB"),
				    #"Added Custom" = Table.AddColumn(#"Changed Type with Locale", "DQ_Reason", each Text.Combine(
				    List.RemoveNulls({
				        if [actual_worth] <= 100 then "Extremely Low Transaction Value" else null,
				        if [procedure_area] <= 1 then "Extremely Small Area" else null,
				        if [meter_sale_price] >= 500000 then "Extremely High Price per sqm" else null,
				        if [procedure_area] >= 1000000 then "Extremely Large Area" else null
				    }),
				    " | "
				)),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "DQ_Flag", each if [DQ_Reason] = "" then "OK" else "Review"),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom1",{{"DQ_Reason", type text}, {"DQ_Flag", type text}}),
				    #"Removed Other Columns" = Table.SelectColumns(#"Changed Type",{"transaction_id", "procedure_id", "procedure_name_en", "instance_date", "property_type_id", "property_type_en", "property_sub_type_id", "property_sub_type_en", "property_usage_en", "reg_type_id", "reg_type_en", "area_id", "area_name_en", "building_name_en", "project_number", "project_name_en", "master_project_en", "nearest_landmark_en", "nearest_metro_en", "nearest_mall_en", "rooms_en", "has_parking", "procedure_area", "actual_worth", "meter_sale_price", "no_of_parties_role_1", "no_of_parties_role_2", "no_of_parties_role_3", "DQ_Reason", "DQ_Flag"}),
				    #"Trimmed Text" = Table.TransformColumns(#"Removed Other Columns",{{"property_usage_en", Text.Trim, type text}, {"building_name_en", Text.Trim, type text}, {"project_name_en", Text.Trim, type text}, {"nearest_metro_en", Text.Trim, type text}}),
				    #"Added Custom2" = Table.AddColumn(#"Trimmed Text", "PropertyKey", each Text.From([property_type_id], "en-US")
				& "|"
				& (if [property_sub_type_id] = null
				    then "NO_SUBTYPE"
				    else Text.From([property_sub_type_id], "en-US"))
				& "|"
				& [property_usage_en]),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom2",{{"PropertyKey", type text}})
				in
				    #"Changed Type1"

	changedProperty = IsHidden

