table Measures_Table
	lineageTag: f86f7ae8-5cdb-4ed3-9b55-8823232c1377

	/// Number of sales transactions in the current filter context.
	measure 'Sales Transactions' = COUNTROWS ( FactSales )
		formatString: #,##0
		displayFolder: Core KPIs
		lineageTag: 3caad400-5ae9-44fd-b271-ca82c659e158

	/// Total sales transaction value in AED in the current filter context.
	measure 'Total Sales Value' = SUM ( FactSales[actual_worth] )
		formatString: "AED" #,##0
		displayFolder: Core KPIs
		lineageTag: 31edeab2-0825-4671-a49c-8dc39b796f8e

		annotation PBI_FormatHint = {"isCustom":true}

	/// Total procedure area in square metres; helper for weighted price calculation.
	measure 'Total Sales Area' = SUM ( FactSales[procedure_area] )
		formatString: #,##0.00
		isHidden
		displayFolder: Supporting & Validation
		lineageTag: 1c858aed-5e98-4ece-b4e8-20e8257e2c45

	/// Median transaction value in AED in the current filter context.
	measure 'Median Transaction Value' = MEDIAN ( FactSales[actual_worth] )
		formatString: "AED" #,##0.00
		displayFolder: Core KPIs
		lineageTag: 6898adae-aba0-4645-99a2-be7e29e47862

		annotation PBI_FormatHint = {"isCustom":true}

	/// Area-weighted price per sqm; supporting diagnostic sensitive to area and property mix.
	measure 'Weighted Avg Price per sqm' =
			DIVIDE (
			    [Total Sales Value],
			    [Total Sales Area]
			)
		formatString: AED #,##0.00
		isHidden
		displayFolder: Supporting & Validation
		lineageTag: 0845b77c-da2c-4f64-adaa-62e02906b7b3

	/// Median transaction-level price per sqm in the current filter context.
	measure 'Median Price per sqm' = MEDIAN ( FactSales[meter_sale_price] )
		formatString: "AED" #,##0.00
		displayFolder: Core KPIs
		lineageTag: 2512d189-36b1-4467-8651-2bcf792f8720

		annotation PBI_FormatHint = {"isCustom":true}

	/// Area share of transactions after removing the Area dimension filter only.
	measure 'Area Transaction Share %' =
			DIVIDE (
			    [Sales Transactions],
			    CALCULATE (
			        [Sales Transactions],
			        REMOVEFILTERS ( DimArea )
			    )
			)
		formatString: 0.0%
		displayFolder: Market Share
		lineageTag: 490a36e2-a81c-436d-a0df-57979bc95349

	/// Area share of sales value after removing the Area dimension filter only.
	measure 'Area Sales Value Share %' =
			DIVIDE (
			    [Total Sales Value],
			    CALCULATE (
			        [Total Sales Value],
			        REMOVEFILTERS ( DimArea )
			    )
			)
		formatString: 0.0%
		displayFolder: Market Share
		lineageTag: acee7ebf-721e-4d09-b97f-f0fc6d78c930

	/// Registration-type share of transactions after removing the Registration dimension filter only.
	measure 'Registration Transaction Share %' =
			DIVIDE (
			    [Sales Transactions],
			    CALCULATE (
			        [Sales Transactions],
			        REMOVEFILTERS ( DimRegistration )
			    )
			)
		formatString: 0.0%
		displayFolder: Market Share
		lineageTag: 624eb6c4-5829-4760-aa03-0b6d13e9ff74

	/// Registration-type share of sales value after removing the Registration dimension filter only.
	measure 'Registration Sales Value Share %' =
			DIVIDE (
			    [Total Sales Value],
			    CALCULATE (
			        [Total Sales Value],
			        REMOVEFILTERS ( DimRegistration )
			    )
			)
		formatString: 0.0%
		displayFolder: Market Share
		lineageTag: 2da9a2dc-015a-4a84-a90a-633cb70a476b

	/// Validation control for weighted price using DQ_Flag = OK only.
	measure 'Weighted Avg Price per sqm — OK Only' =
			CALCULATE (
			    [Weighted Avg Price per sqm],
			    REMOVEFILTERS (
			        FactSales[DQ_Flag],
			        FactSales[DQ_Reason]
			    ),
			    FactSales[DQ_Flag] = "OK"
			)
		formatString: AED #,##0.00
		isHidden
		displayFolder: Supporting & Validation
		lineageTag: 222b1793-4da8-4c3a-b704-8cd8cfc00f60

	/// Fact row count minus distinct transaction IDs; expected result is zero.
	measure 'Transaction Grain Check' =
			[Sales Transactions]
			    - DISTINCTCOUNT ( FactSales[transaction_id] )
		formatString: #,##0
		isHidden
		displayFolder: Supporting & Validation
		lineageTag: 9098fd7d-0274-45cd-bf30-3ebd3b19b1ad

	/// Month-over-month percentage change in sales transactions.
	measure 'Sales Transactions MoM %' =
			VAR PreviousValue =
			    CALCULATE (
			        [Sales Transactions],
			        DATEADD (
			            DimDate[Date],
			            -1,
			            MONTH
			        )
			    )
			RETURN
			    IF (
			        ISBLANK ( PreviousValue )
			            || PreviousValue = 0,
			        BLANK (),
			        DIVIDE (
			            [Sales Transactions] - PreviousValue,
			            PreviousValue
			        )
			    )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 38619270-4afd-4a62-a1ed-20fb41824bb4

	/// Year-over-year percentage change in sales transactions.
	measure 'Sales Transactions YoY %' =
			VAR PreviousValue =
			    CALCULATE (
			        [Sales Transactions],
			        SAMEPERIODLASTYEAR ( DimDate[Date] )
			    )
			RETURN
			    IF (
			        ISBLANK ( PreviousValue )
			            || PreviousValue = 0,
			        BLANK (),
			        DIVIDE (
			            [Sales Transactions] - PreviousValue,
			            PreviousValue
			        )
			    )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: aa8bcd31-64bf-4c63-917f-65d07470e786

	/// Month-over-month percentage change in total sales value.
	measure 'Total Sales Value MoM %' =
			VAR PreviousValue =
			    CALCULATE (
			        [Total Sales Value],
			        DATEADD (
			            DimDate[Date],
			            -1,
			            MONTH
			        )
			    )
			RETURN
			    IF (
			        ISBLANK ( PreviousValue )
			            || PreviousValue = 0,
			        BLANK (),
			        DIVIDE (
			            [Total Sales Value] - PreviousValue,
			            PreviousValue
			        )
			    )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 531e7dab-b934-4ee8-bd5a-802df2f93928

	/// Year-over-year percentage change in total sales value.
	measure 'Total Sales Value YoY %' =
			VAR PreviousValue =
			    CALCULATE (
			        [Total Sales Value],
			        SAMEPERIODLASTYEAR ( DimDate[Date] )
			    )
			RETURN
			    IF (
			        ISBLANK ( PreviousValue )
			            || PreviousValue = 0,
			        BLANK (),
			        DIVIDE (
			            [Total Sales Value] - PreviousValue,
			            PreviousValue
			        )
			    )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: caf246a1-db48-4a13-80a3-abebd7f1d90e

	/// Month-over-month percentage change in median price per sqm.
	measure 'Median Price per sqm MoM %' =
			VAR PreviousValue =
			    CALCULATE (
			        [Median Price per sqm],
			        DATEADD (
			            DimDate[Date],
			            -1,
			            MONTH
			        )
			    )
			RETURN
			    IF (
			        ISBLANK ( PreviousValue )
			            || PreviousValue = 0,
			        BLANK (),
			        DIVIDE (
			            [Median Price per sqm] - PreviousValue,
			            PreviousValue
			        )
			    )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 5baab062-ddda-4246-8f13-a80aeca03a9e

	/// Year-over-year percentage change in median price per sqm.
	measure 'Median Price per sqm YoY %' =
			VAR PreviousValue =
			    CALCULATE (
			        [Median Price per sqm],
			        SAMEPERIODLASTYEAR ( DimDate[Date] )
			    )
			RETURN
			    IF (
			        ISBLANK ( PreviousValue )
			            || PreviousValue = 0,
			        BLANK (),
			        DIVIDE (
			            [Median Price per sqm] - PreviousValue,
			            PreviousValue
			        )
			    )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 130f5968-67c2-4660-b2d4-1b99c7b53a5d

	column 'Measure Holder'
		isHidden
		formatString: 0
		lineageTag: caa65c1f-e7a4-45af-b149-8834d99c94c0
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Measure Holder]

		annotation SummarizationSetBy = Automatic

	partition Measures_Table = calculated
		mode: import
		source =
				
				ROW (
				    "Measure Holder", BLANK()
				)

	annotation PBI_Id = 290b79edbe9f418e8a0fa159aa5cd646

