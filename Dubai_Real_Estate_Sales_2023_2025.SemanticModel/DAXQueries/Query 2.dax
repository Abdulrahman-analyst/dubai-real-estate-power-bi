-- =========================================
-- 1. OVERALL PRICE COMPARISON
-- =========================================

EVALUATE

ROW (
    "Sales Transactions",
        'Measures_Table'[Sales Transactions],

    "Weighted Avg Price per sqm",
        'Measures_Table'[Weighted Avg Price per sqm],

    "Median Price per sqm",
        'Measures_Table'[Median Price per sqm],

    "Difference",
        'Measures_Table'[Weighted Avg Price per sqm]
            - 'Measures_Table'[Median Price per sqm],

    "Difference %",
        DIVIDE (
            'Measures_Table'[Weighted Avg Price per sqm]
                - 'Measures_Table'[Median Price per sqm],
            'Measures_Table'[Median Price per sqm]
        )
)


-- =========================================
-- 2. PRICE COMPARISON BY PROPERTY TYPE
-- =========================================

EVALUATE

SUMMARIZECOLUMNS (
    DimProperty[property_type_en],

    "Sales Transactions",
        'Measures_Table'[Sales Transactions],

    "Weighted Avg Price per sqm",
        'Measures_Table'[Weighted Avg Price per sqm],

    "Median Price per sqm",
        'Measures_Table'[Median Price per sqm],

    "Difference",
        'Measures_Table'[Weighted Avg Price per sqm]
            - 'Measures_Table'[Median Price per sqm],

    "Difference %",
        DIVIDE (
            'Measures_Table'[Weighted Avg Price per sqm]
                - 'Measures_Table'[Median Price per sqm],
            'Measures_Table'[Median Price per sqm]
        )
)

ORDER BY
    DimProperty[property_type_en]


-- =========================================
-- 3. DQ_FLAG IMPACT
-- =========================================

EVALUATE

SUMMARIZECOLUMNS (
    FactSales[DQ_Flag],

    "Sales Transactions",
        'Measures_Table'[Sales Transactions],

    "Total Sales Value",
        'Measures_Table'[Total Sales Value],

    "Total Sales Area",
        'Measures_Table'[Total Sales Area],

    "Weighted Avg Price per sqm",
        'Measures_Table'[Weighted Avg Price per sqm],

    "Median Price per sqm",
        'Measures_Table'[Median Price per sqm],

    "Difference %",
        DIVIDE (
            'Measures_Table'[Weighted Avg Price per sqm]
                - 'Measures_Table'[Median Price per sqm],
            'Measures_Table'[Median Price per sqm]
        )
)

ORDER BY
    FactSales[DQ_Flag]


-- =========================================
-- 4. PROPERTY TYPE x DQ_FLAG
-- =========================================

EVALUATE

SUMMARIZECOLUMNS (
    DimProperty[property_type_en],
    FactSales[DQ_Flag],

    "Sales Transactions",
        'Measures_Table'[Sales Transactions],

    "Weighted Avg Price per sqm",
        'Measures_Table'[Weighted Avg Price per sqm],

    "Median Price per sqm",
        'Measures_Table'[Median Price per sqm],

    "Difference %",
        DIVIDE (
            'Measures_Table'[Weighted Avg Price per sqm]
                - 'Measures_Table'[Median Price per sqm],
            'Measures_Table'[Median Price per sqm]
        )
)

ORDER BY
    DimProperty[property_type_en],
    FactSales[DQ_Flag]


-- =========================================
-- 5. HIGHEST 20 PRICE / SQM RECORDS
-- =========================================

EVALUATE

SELECTCOLUMNS (
    TOPN (
        20,
        FactSales,
        FactSales[meter_sale_price], DESC,
        FactSales[transaction_id], ASC
    ),

    "transaction_id", FactSales[transaction_id],
    "instance_date", FactSales[instance_date],
    "property_type_en", FactSales[property_type_en],
    "property_sub_type_en", FactSales[property_sub_type_en],
    "property_usage_en", FactSales[property_usage_en],
    "area_name_en", FactSales[area_name_en],
    "actual_worth", FactSales[actual_worth],
    "procedure_area", FactSales[procedure_area],
    "meter_sale_price", FactSales[meter_sale_price],
    "DQ_Flag", FactSales[DQ_Flag],
    "DQ_Reason", FactSales[DQ_Reason]
)

ORDER BY
    [meter_sale_price] DESC


-- =========================================
-- 6. LOWEST 20 PRICE / SQM RECORDS
-- =========================================

EVALUATE

SELECTCOLUMNS (
    TOPN (
        20,
        FactSales,
        FactSales[meter_sale_price], ASC,
        FactSales[transaction_id], ASC
    ),

    "transaction_id", FactSales[transaction_id],
    "instance_date", FactSales[instance_date],
    "property_type_en", FactSales[property_type_en],
    "property_sub_type_en", FactSales[property_sub_type_en],
    "property_usage_en", FactSales[property_usage_en],
    "area_name_en", FactSales[area_name_en],
    "actual_worth", FactSales[actual_worth],
    "procedure_area", FactSales[procedure_area],
    "meter_sale_price", FactSales[meter_sale_price],
    "DQ_Flag", FactSales[DQ_Flag],
    "DQ_Reason", FactSales[DQ_Reason]
)

ORDER BY
    [meter_sale_price] ASC