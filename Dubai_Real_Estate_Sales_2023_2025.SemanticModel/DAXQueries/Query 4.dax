-- =========================================================
-- RESULT 1
-- Overall reconciliation
-- =========================================================

EVALUATE

ROW (
    "Sales Transactions",
        [Sales Transactions],

    "Expected Transactions",
        526056,

    "Count Difference",
        [Sales Transactions] - 526056,

    "Transaction Grain Check",
        [Transaction Grain Check],

    "Median Price per sqm",
        [Median Price per sqm],

    "Weighted Avg Price per sqm",
        [Weighted Avg Price per sqm],

    "Weighted Avg Price per sqm - OK Only",
        [Weighted Avg Price per sqm — OK Only]
)


-- =========================================================
-- RESULT 2
-- Grain validation under different filters
-- Every Grain Check should = 0
-- =========================================================

EVALUATE

UNION (

    ROW (
        "Context", "All Sales",
        "Grain Check", [Transaction Grain Check]
    ),

    ROW (
        "Context", "Year 2025",
        "Grain Check",
            CALCULATE (
                [Transaction Grain Check],
                DimDate[Year] = 2025
            )
    ),

    ROW (
        "Context", "Property Type = Unit",
        "Grain Check",
            CALCULATE (
                [Transaction Grain Check],
                DimProperty[property_type_en] = "Unit"
            )
    ),

    ROW (
        "Context", "Registration = Existing",
        "Grain Check",
            CALCULATE (
                [Transaction Grain Check],
                DimRegistration[reg_type_en] = "Existing"
            )
    ),

    ROW (
        "Context", "2024 + Villa + Off-Plan",
        "Grain Check",
            CALCULATE (
                [Transaction Grain Check],
                DimDate[Year] = 2024,
                DimProperty[property_type_en] = "Villa",
                DimRegistration[reg_type_en] = "Off-Plan"
            )
    )
)


-- =========================================================
-- RESULT 3
-- Annual reconciliation + YoY validation
-- =========================================================

EVALUATE

SUMMARIZECOLUMNS (
    DimDate[Year],

    "Sales Transactions",
        [Sales Transactions],

    "Expected Count",
        SWITCH (
            SELECTEDVALUE ( DimDate[Year] ),
            2023, 131805,
            2024, 179425,
            2025, 214826
        ),

    "Count Difference",
        [Sales Transactions]
            -
        SWITCH (
            SELECTEDVALUE ( DimDate[Year] ),
            2023, 131805,
            2024, 179425,
            2025, 214826
        ),


    "Transactions YoY %",
        [Sales Transactions YoY %],

    "Transactions YoY Control",
        VAR CurrentYear =
            SELECTEDVALUE ( DimDate[Year] )

        VAR CurrentValue =
            [Sales Transactions]

        VAR PreviousValue =
            CALCULATE (
                [Sales Transactions],
                REMOVEFILTERS ( DimDate ),
                DimDate[Year] = CurrentYear - 1
            )

        RETURN
            IF (
                ISBLANK ( PreviousValue )
                    || PreviousValue = 0,
                BLANK (),
                DIVIDE (
                    CurrentValue - PreviousValue,
                    PreviousValue
                )
            ),


    "Sales Value YoY %",
        [Total Sales Value YoY %],

    "Sales Value YoY Control",
        VAR CurrentYear =
            SELECTEDVALUE ( DimDate[Year] )

        VAR CurrentValue =
            [Total Sales Value]

        VAR PreviousValue =
            CALCULATE (
                [Total Sales Value],
                REMOVEFILTERS ( DimDate ),
                DimDate[Year] = CurrentYear - 1
            )

        RETURN
            IF (
                ISBLANK ( PreviousValue )
                    || PreviousValue = 0,
                BLANK (),
                DIVIDE (
                    CurrentValue - PreviousValue,
                    PreviousValue
                )
            ),


    "Median Price YoY %",
        [Median Price per sqm YoY %],

    "Median Price YoY Control",
        VAR CurrentYear =
            SELECTEDVALUE ( DimDate[Year] )

        VAR CurrentValue =
            [Median Price per sqm]

        VAR PreviousValue =
            CALCULATE (
                [Median Price per sqm],
                REMOVEFILTERS ( DimDate ),
                DimDate[Year] = CurrentYear - 1
            )

        RETURN
            IF (
                ISBLANK ( PreviousValue )
                    || PreviousValue = 0,
                BLANK (),
                DIVIDE (
                    CurrentValue - PreviousValue,
                    PreviousValue
                )
            )
)

ORDER BY
    DimDate[Year]


-- =========================================================
-- RESULT 4
-- MoM validation
-- Jan 2023 should have no valid previous month.
-- Jan 2024 measures should independently match Dec 2023.
-- =========================================================

EVALUATE

VAR Jan2023TransactionsMoM =
    CALCULATE (
        [Sales Transactions MoM %],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2023, 1, 1 ),
            DATE ( 2023, 1, 31 )
        )
    )

VAR Jan2023ValueMoM =
    CALCULATE (
        [Total Sales Value MoM %],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2023, 1, 1 ),
            DATE ( 2023, 1, 31 )
        )
    )

VAR Jan2023MedianMoM =
    CALCULATE (
        [Median Price per sqm MoM %],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2023, 1, 1 ),
            DATE ( 2023, 1, 31 )
        )
    )


VAR Jan2024Transactions =
    CALCULATE (
        [Sales Transactions],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2024, 1, 1 ),
            DATE ( 2024, 1, 31 )
        )
    )

VAR Dec2023Transactions =
    CALCULATE (
        [Sales Transactions],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2023, 12, 1 ),
            DATE ( 2023, 12, 31 )
        )
    )

VAR TransactionsControl =
    DIVIDE (
        Jan2024Transactions - Dec2023Transactions,
        Dec2023Transactions
    )

VAR TransactionsMeasure =
    CALCULATE (
        [Sales Transactions MoM %],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2024, 1, 1 ),
            DATE ( 2024, 1, 31 )
        )
    )


VAR Jan2024Value =
    CALCULATE (
        [Total Sales Value],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2024, 1, 1 ),
            DATE ( 2024, 1, 31 )
        )
    )

VAR Dec2023Value =
    CALCULATE (
        [Total Sales Value],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2023, 12, 1 ),
            DATE ( 2023, 12, 31 )
        )
    )

VAR ValueControl =
    DIVIDE (
        Jan2024Value - Dec2023Value,
        Dec2023Value
    )

VAR ValueMeasure =
    CALCULATE (
        [Total Sales Value MoM %],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2024, 1, 1 ),
            DATE ( 2024, 1, 31 )
        )
    )


VAR Jan2024Median =
    CALCULATE (
        [Median Price per sqm],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2024, 1, 1 ),
            DATE ( 2024, 1, 31 )
        )
    )

VAR Dec2023Median =
    CALCULATE (
        [Median Price per sqm],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2023, 12, 1 ),
            DATE ( 2023, 12, 31 )
        )
    )

VAR MedianControl =
    DIVIDE (
        Jan2024Median - Dec2023Median,
        Dec2023Median
    )

VAR MedianMeasure =
    CALCULATE (
        [Median Price per sqm MoM %],
        DATESBETWEEN (
            DimDate[Date],
            DATE ( 2024, 1, 1 ),
            DATE ( 2024, 1, 31 )
        )
    )

RETURN

ROW (
    "Jan 2023 Transactions MoM",
        Jan2023TransactionsMoM,

    "Jan 2023 Sales Value MoM",
        Jan2023ValueMoM,

    "Jan 2023 Median Price MoM",
        Jan2023MedianMoM,

    "Jan 2024 Transactions Difference",
        TransactionsMeasure - TransactionsControl,

    "Jan 2024 Sales Value Difference",
        ValueMeasure - ValueControl,

    "Jan 2024 Median Price Difference",
        MedianMeasure - MedianControl
)


-- =========================================================
-- RESULT 5
-- Market Share validation
-- Preserve Year + Property filters.
-- Shares should sum to 1.
-- =========================================================

EVALUATE

ROW (

    "Area Transaction Share Sum",
        CALCULATE (
            SUMX (
                VALUES ( DimArea[area_name_en] ),
                [Area Transaction Share %]
            ),
            DimDate[Year] = 2025,
            DimProperty[property_usage_en] = "Residential"
        ),

    "Area Sales Value Share Sum",
        CALCULATE (
            SUMX (
                VALUES ( DimArea[area_name_en] ),
                [Area Sales Value Share %]
            ),
            DimDate[Year] = 2025,
            DimProperty[property_usage_en] = "Residential"
        ),

    "Registration Transaction Share Sum",
        CALCULATE (
            SUMX (
                VALUES ( DimRegistration[reg_type_en] ),
                [Registration Transaction Share %]
            ),
            DimDate[Year] = 2025,
            DimProperty[property_usage_en] = "Residential"
        ),

    "Registration Sales Value Share Sum",
        CALCULATE (
            SUMX (
                VALUES ( DimRegistration[reg_type_en] ),
                [Registration Sales Value Share %]
            ),
            DimDate[Year] = 2025,
            DimProperty[property_usage_en] = "Residential"
        )
)