-- RESULT 1
-- Actual Registration values + Grain Check

EVALUATE

SUMMARIZECOLUMNS (
    DimRegistration[reg_type_en],

    "Sales Transactions",
        [Sales Transactions],

    "Transaction Grain Check",
        [Transaction Grain Check]
)

ORDER BY
    DimRegistration[reg_type_en]


-- RESULT 2
-- Combined filter test using 2024 + Villa,
-- grouped by the actual Registration values that exist

EVALUATE

CALCULATETABLE (
    SUMMARIZECOLUMNS (
        DimRegistration[reg_type_en],

        "Sales Transactions",
            [Sales Transactions],

        "Transaction Grain Check",
            [Transaction Grain Check]
    ),

    DimDate[Year] = 2024,
    DimProperty[property_type_en] = "Villa"
)

ORDER BY
    DimRegistration[reg_type_en]